    <servlet-mapping>
        <servlet-name>SignUpServlet</servlet-name>
        <url-pattern>/SignUpServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AIServlet</servlet-name>
        <url-pattern>/AIServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ExploreVarsityServlet</servlet-name>
        <url-pattern>/ExploreVarsityServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DashboardDataRetrievalServlet</servlet-name>
        <url-pattern>/DashboardDataRetrievalServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CourseSuggestionServlet</servlet-name>
        <url-pattern>/CourseSuggestionServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ExploreCourseServlet</servlet-name>
        <url-pattern>/ExploreCourseServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/LogoutServlet.do</url-pattern>
