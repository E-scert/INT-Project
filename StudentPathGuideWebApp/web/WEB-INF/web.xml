        <servlet-name>VarsitySuggestionServlet</servlet-name>
        <url-pattern>/VarsitySuggestionServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UpdateDataServlet</servlet-name>
        <url-pattern>/UpdateDataServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ListAllStudentsServlet</servlet-name>
        <url-pattern>/ListAllStudentsServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ListStudentsBasedOnAPS</servlet-name>
        <url-pattern>/ListStudentsBasedOnAPS.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ListStudentsBetweenMinAndMaxApsServlet</servlet-name>
        <url-pattern>/ListStudentsBetweenMinAndMaxApsServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ListStudentsBasedOnGradeServlet</servlet-name>
        <url-pattern>/ListStudentsBasedOnGradeServlet.do</url-pattern>
