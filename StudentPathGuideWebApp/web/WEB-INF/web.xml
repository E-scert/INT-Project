        <servlet-name>ExploreCourseServlet</servlet-name>
        <servlet-class>com.apexcoders.web.ExploreCourseServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.apexcoders.web.LogoutServlet</servlet-class>
