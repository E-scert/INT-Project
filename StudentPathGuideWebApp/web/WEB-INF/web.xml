    <servlet-mapping>
        <servlet-name>ListStudentsBasedOnFieldServlet</servlet-name>
        <url-pattern>/ListStudentsBasedOnFieldServlet</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    
    <security-constraint>
        <display-name>ApexCoderConstraint</display-name>
        <web-resource-collection>
            <web-resource-name>ApexCoderResource</web-resource-name>
            <description>resource</description>
            <url-pattern>/admin_page.jsp</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description>Authenticate apexcoder</description>
            <role-name>apexcoder</role-name>
        </auth-constraint>
    </security-constraint>
    <login-config>
        <auth-method>FORM</auth-method>
        <realm-name>file</realm-name>
        <form-login-config>
            <form-login-page>/login.jsp</form-login-page>
            <form-error-page>/error_page.jsp</form-error-page>
        </form-login-config>
    </login-config>
    <security-role>
        <description/>
        <role-name>apexcoder</role-name>
    </security-role>
    
    <resource-env-ref>
  <resource-env-ref-name>gemini/apiKey</resource-env-ref-name>
  <resource-env-ref-type>java.lang.String</resource-env-ref-type>
</resource-env-ref>
</web-app>
